# Follow the latest commit on each listed branch. Keep Honk first for package precedence.
src-git honk https://github.com/kenzok8/openwrt-honk.git;main
# Use the branches matching ImmortalWrt 25.12.
src-git packages https://github.com/immortalwrt/packages.git;openwrt-25.12
src-git luci https://github.com/immortalwrt/luci.git;openwrt-25.12
src-git routing https://github.com/openwrt/routing.git;openwrt-25.12
# Official QuickStart backend, LuCI UI, and its iStore/taskd dependencies.
src-git nas https://github.com/linkease/nas-packages.git;master
src-git nas_luci https://github.com/linkease/nas-packages-luci.git;main
src-git istore https://github.com/istoreos/istore.git;main
